# Optional overrides for the unified ThirdHand runtime.
# Runtime profiles in configs/runtime are the default source of truth.

# Web Gateway
WEB_HOST=192.168.58.68
WEB_PORT=9983
ROBOT_WS_URL=ws://127.0.0.1:3000/ws
VOICE_WS_URL=ws://127.0.0.1:3004/v1/voice
VISION_HTTP_URL=http://127.0.0.1:3100
VISION_WS_URL=ws://127.0.0.1:3100/ws

# Startouch Robot Service
ROBOT_HOST=127.0.0.1
ROBOT_PORT=3000
STARTOUCH_CAN_INTERFACE=can0
STARTOUCH_GRIPPER=1
STARTOUCH_REQUIRE_CAN_RX=1
STARTOUCH_SIMULATE=0
STARTOUCH_DRY_RUN=0

# Speech and model access
THIRDHAND_ASR_MODEL=medium
TEXT_LLM_MODEL=deepseek-v4-pro
VISION_LLM_MODEL=deepseek-flash
VISION_STREAM_URL=http://127.0.0.1:3100/camera/xvisio/raw
VISION_QA_MAX_FRAME_AGE_MS=2000
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Vision Service
VISION_HOST=127.0.0.1
VISION_PORT=3100
VISION_CONFIG=configs/vision.yaml

# Launcher profile
THIRDHAND_PROFILE=manual-control
