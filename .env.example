# ============================================================
# UIEA ThirdHand VLA — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ============================================================

# --- VLA Cloud API ---
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
# DeepSeek (alternative)
DEEPSEEK_API_KEY=sk-...
# OpenAI-compatible (generic)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Aliyun NLS (if using cloud ASR/TTS fallback) ---
ALIYUN_NLS_APPKEY=your_appkey_here
ALIYUN_NLS_ACCESS_KEY=your_ak_here
ALIYUN_NLS_ACCESS_SECRET=your_sk_here

# --- Robot Connection ---
# Override YAML config via env vars
# THIRDHAND_ROBOT_CAN_INTERFACE=can0
# THIRDHAND_ROBOT_IP=192.168.58.2

# --- PART D Execution contract adapter (loopback-only, no secrets) ---
# The checked-in delivery refuses any host other than 127.0.0.1 and always
# refuses real mode. These settings do not start the Startouch bridge.
THIRDHAND_ROBOT_HOST=127.0.0.1
THIRDHAND_ROBOT_PORT=7788
THIRDHAND_ROBOT_ENDPOINT=http://127.0.0.1:7788/v1/execution
THIRDHAND_ROBOT_REQUEST_TIMEOUT_S=5
THIRDHAND_ROBOT_MAX_BODY_BYTES=1048576
# Optional when the shared contract is not at contracts/schema.json or
# ../contracts/schema.json relative to this checkout.
# THIRDHAND_CONTRACT_SCHEMA=/absolute/path/to/contracts/schema.json
# Optional Orchestrator-owned JSON binding of sessionId to traceId,
# candidateId, decisionId, and targetId. Do not put credentials in this file.
# THIRDHAND_EXECUTION_BINDINGS_FILE=/absolute/path/to/identity_bindings.json

# --- Web Server ---
# THIRDHAND_WEB_HOST=0.0.0.0
# THIRDHAND_WEB_PORT=8000
