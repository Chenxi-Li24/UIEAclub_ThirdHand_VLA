*.sh text eol=lf
History/legacy-web/**/web/js/lib/** -whitespace
*.urdf -whitespace

# Preserve imported and retired source snapshots byte-for-byte.
History/source-snapshots/** -whitespace
History/retired/** -whitespace
# Preserve the original Markdown hard breaks in this hashed historical handover.
History/legacy-calibration-20261008/source/HANDOVER.md whitespace=-blank-at-eol

# Explicit runtime payloads; configuration and URDF remain ordinary Git text.
local/** -text
assets/robot/startouch-v3/** -text
assets/robot/startouch-v3/meshes/** filter=lfs diff=lfs merge=lfs -text
assets/robot/startouch-v3/web/*.glb* filter=lfs diff=lfs merge=lfs -text
assets/robot/startouch-v3/web/*.json text eol=lf
apps/dummy/models/*.tflite filter=lfs diff=lfs merge=lfs -text
local/models/**/*.pt filter=lfs diff=lfs merge=lfs -text
local/models/**/*.bin filter=lfs diff=lfs merge=lfs -text
local/models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
local/models/**/*.pt.parts/* filter=lfs diff=lfs merge=lfs -text
local/models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
local/sdk/**/*.so* filter=lfs diff=lfs merge=lfs -text
local/sdk/**/*.deb filter=lfs diff=lfs merge=lfs -text
local/generated/**/*.so* filter=lfs diff=lfs merge=lfs -text

# Content-bound source/configuration must retain identical bytes across clones.
services/robot/src/robot-controller.js text eol=lf
services/robot/src/startouch_bridge.py text eol=lf
configs/vision/sdk-tool-frame-policy.json text eol=lf
configs/vision/handeye-flange-normalized.json text eol=lf
apps/web/configs/web-grasp.json text eol=lf
# User-selected classic presentation snapshot: retain exact source commit bytes.
apps/web/public/classic.html -text -whitespace
apps/web/public/css/classic-source.css -text -whitespace
# C8 fixed deployment artifacts are hashed before upload.
deploy/public-access/staging/device/c8-active-pins.json text eol=lf
tools/operations/apply_ui_sdk_active_device.py text eol=lf
tools/operations/apply_ui_sdk_followup_cloud.py text eol=lf
tools/operations/apply_login_wait_cloud.py text eol=lf
tools/operations/apply_sdk_scope_cloud.py text eol=lf
tools/operations/apply_sdk_scope_device.py text eol=lf
deploy/public-access/staging/device/sdk-scope-pins.json text eol=lf
