# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE and operating system
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
api_keys.yaml

# Existing runtime output
logs/**
!logs/README.md
!logs/.gitkeep
*.pid
data/calibration/*.npz
data/calibration/*.yaml
data/calibration/active-view/
/models/vision/
/artifacts/vision/
configs/tasks/.fixed_pick_place_backups/

# Downloaded model weights and notebooks
*.pt
*.onnx
.ipynb_checkpoints/
*.ipynb

# Node and PlatformIO
node_modules/
dist/
.pio/

# Runtime assets are tracked explicitly; environments and mutable state stay local.
/local/**
!/local/README.md
!/local/sdk/
!/local/sdk/**
!/local/models/
!/local/models/**
!/local/vendor/
!/local/vendor/funasr/
!/local/vendor/funasr/**
!/local/generated/
!/local/generated/startouch-python/
!/local/generated/startouch-python/**
/configs/assets/manifest.local.json

# Unified mutable runtime state
/runtime/**
!/runtime/README.md

# The high ASR checkpoint is reconstructed from LFS parts by the setup script.
/local/models/asr/high/model.pt
/local/**/__pycache__/
/local/**/*.pyc
/local/**/.git/
/local/**/.cache/
/local/**/.locks/
/local/**/build/
/local/**/dist/

# History preserves source only, never copied environments or runtime payloads.
/History/**/.git/
/History/**/.venv/
/History/**/.conda-*/
/History/**/node_modules/
/History/**/runtime/
/History/**/models/
/History/**/artifacts/
/History/**/logs/
/History/**/build/
/History/**/dist/
/History/**/.mypy_cache/
/History/**/.ruff_cache/
/History/**/.superpowers/

# Agent implementation ledgers and review packages
/.superpowers/
