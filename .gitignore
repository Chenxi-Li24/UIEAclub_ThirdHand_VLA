# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE and operating system
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
api_keys.yaml

# Existing runtime output
logs/**
!logs/README.md
!logs/.gitkeep
*.pid
data/calibration/*.npz
data/calibration/*.yaml
data/calibration/active-view/
/models/vision/
/artifacts/vision/
configs/tasks/.fixed_pick_place_backups/

# Downloaded model weights and notebooks
*.pt
*.onnx
.ipynb_checkpoints/
*.ipynb

# Node and PlatformIO
node_modules/
dist/
.pio/

# Unified local delivery assets: present on Ubuntu, never tracked publicly
/local/**
!/local/README.md
/configs/assets/manifest.local.json

# Unified mutable runtime state
/runtime/**
!/runtime/README.md

# Robot geometry is local runtime payload; Git stores its manifest and importer.
/assets/robot/startouch-v3/

# History preserves source only, never copied environments or runtime payloads.
/History/**/.git/
/History/**/.venv/
/History/**/.conda-*/
/History/**/node_modules/
/History/**/runtime/
/History/**/models/
/History/**/artifacts/
/History/**/logs/
/History/**/build/
/History/**/dist/
/History/**/.mypy_cache/
/History/**/.ruff_cache/
/History/**/.superpowers/

# Agent implementation ledgers and review packages
/.superpowers/
