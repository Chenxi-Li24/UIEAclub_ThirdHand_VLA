# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE and operating system
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
api_keys.yaml

# Existing runtime output
logs/**
!logs/.gitkeep
*.pid
data/calibration/*.npz
data/calibration/*.yaml
data/calibration/active-view/
/models/vision/
/artifacts/vision/
configs/tasks/.fixed_pick_place_backups/

# Downloaded model weights and notebooks
*.pt
*.onnx
.ipynb_checkpoints/
*.ipynb

# Node and PlatformIO
node_modules/
dist/
.pio/

# Standalone Startouch web control runtime
web-control/.env
web-control/server/web-control.log

# Unified local delivery assets: present on Ubuntu, never tracked publicly
/local/**
!/local/README.md
/configs/assets/manifest.local.json

# Unified mutable runtime state
/runtime/**
!/runtime/README.md

# Robot geometry is local runtime payload; Git stores its manifest and importer.
/assets/robot/startouch-v3/

# Archive may keep reviewed first-party source, but not copied runtime payloads
/archive/**/node_modules/
/archive/**/.venv/
/archive/**/build/
/archive/**/dist/
/archive/**/models/
/archive/**/logs/

# Source snapshot payloads that must never enter Git if reintroduced later
/migration/sources/**/.git/
/migration/sources/**/.venv/
/migration/sources/**/.conda-*/
/migration/sources/**/node_modules/
/migration/sources/**/runtime/
/migration/sources/**/models/
/migration/sources/**/artifacts/
/migration/sources/**/logs/
/migration/sources/**/build/
/migration/sources/**/.mypy_cache/
/migration/sources/**/.ruff_cache/
/migration/sources/**/.superpowers/
/archive/source-snapshots/**/.mypy_cache/
/archive/source-snapshots/**/.ruff_cache/
/archive/source-snapshots/**/.superpowers/
