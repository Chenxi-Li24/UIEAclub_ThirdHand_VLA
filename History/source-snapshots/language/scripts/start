#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(dirname -- "$SCRIPT_DIR")
ENV_FILE=${RUNTIME_ENV_FILE:-$PROJECT_ROOT/config/runtime.env}
PYTHON_BIN=${PYTHON_BIN:-$PROJECT_ROOT/runtime/python/bin/python3.11}
NODE_BIN=${NODE_BIN:-$PROJECT_ROOT/runtime/node/bin/node}

if [[ ! -r "$ENV_FILE" ]]; then
  echo "ERROR: runtime environment file is missing: $ENV_FILE" >&2
  exit 1
fi
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "ERROR: bundled Python is missing: $PYTHON_BIN" >&2
  exit 1
fi
if [[ ! -x "$NODE_BIN" ]]; then
  echo "ERROR: bundled Node is missing: $NODE_BIN" >&2
  exit 1
fi
if ! command -v setsid >/dev/null 2>&1; then
  echo "ERROR: setsid is required to isolate the Voice/Web process groups" >&2
  exit 1
fi

set -a
source "$ENV_FILE"
set +a
RUN_DIR=$PROJECT_ROOT/logs/run
mkdir -p "$RUN_DIR" "$PROJECT_ROOT/logs"

VOICE_PID_FILE=$RUN_DIR/voice-$VOICE_PORT.pid
WEB_PID_FILE=$RUN_DIR/web-$WEB_PORT.pid
VOICE_LOG=$PROJECT_ROOT/logs/voice-$VOICE_PORT.log
WEB_LOG=$PROJECT_ROOT/logs/web-$WEB_PORT.log

refuse_live_pid() {
  local name=$1
  local pid_file=$2
  if [[ -r "$pid_file" ]]; then
    local pid
    pid=$(<"$pid_file")
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      echo "ERROR: $name is already running with PID $pid" >&2
      exit 1
    fi
    rm -f -- "$pid_file"
  fi
}

listener_exists() {
  local host=$1
  local port=$2
  ss -ltnH "src $host and sport = :$port" | grep -q .
}

refuse_listener() {
  local host=$1
  local port=$2
  if listener_exists "$host" "$port"; then
    echo "ERROR: listener $host:$port is already in use" >&2
    exit 1
  fi
}

refuse_live_pid voice-$VOICE_PORT "$VOICE_PID_FILE"
refuse_live_pid web-$WEB_PORT "$WEB_PID_FILE"
refuse_listener "$VOICE_HOST" "$VOICE_PORT"
refuse_listener "$WEB_HOST" "$WEB_PORT"

cd "$PROJECT_ROOT/voice"
nohup setsid "$PYTHON_BIN" voice_bridge.py \
  --host "$VOICE_HOST" \
  --port "$VOICE_PORT" \
  --model-root "$PROJECT_ROOT/models" \
  --paraformer-device "$PARAFORMER_DEVICE" \
  > "$VOICE_LOG" 2>&1 &
voice_pid=$!
echo "$voice_pid" > "$VOICE_PID_FILE"

voice_ready=0
for _ in {1..75}; do
  if ! kill -0 "$voice_pid" 2>/dev/null; then
    echo "ERROR: voice-$VOICE_PORT exited; inspect $VOICE_LOG" >&2
    rm -f -- "$VOICE_PID_FILE"
    exit 1
  fi
  if listener_exists "$VOICE_HOST" "$VOICE_PORT"; then
    if "$PYTHON_BIN" "$PROJECT_ROOT/scripts/voice_ready.py" \
      --endpoint "$VOICE_ENDPOINT" --timeout 2; then
      voice_ready=1
      break
    fi
    echo "ERROR: voice-$VOICE_PORT is listening but default Whisper Small/cuda is not READY" >&2
    kill -TERM -- "-$voice_pid" 2>/dev/null || true
    rm -f -- "$VOICE_PID_FILE"
    exit 1
  fi
  sleep 1
done
if [[ "$voice_ready" != 1 ]]; then
  echo "ERROR: voice-$VOICE_PORT did not become READY within 75 seconds" >&2
  kill -TERM -- "-$voice_pid" 2>/dev/null || true
  rm -f -- "$VOICE_PID_FILE"
  exit 1
fi

cd "$PROJECT_ROOT/app/server"
nohup setsid "$NODE_BIN" proxy.js > "$WEB_LOG" 2>&1 &
web_pid=$!
echo "$web_pid" > "$WEB_PID_FILE"

sleep 1
if ! kill -0 "$web_pid" 2>/dev/null; then
  echo "ERROR: web-$WEB_PORT exited; inspect $WEB_LOG" >&2
  kill -TERM -- "-$voice_pid" 2>/dev/null || true
  rm -f -- "$VOICE_PID_FILE" "$WEB_PID_FILE"
  exit 1
fi

echo "voice-$VOICE_PORT PID=$voice_pid (default model Medium / Whisper Small / cuda)"
echo "web-$WEB_PORT   PID=$web_pid (language upstream: $LANGUAGE_UPSTREAM_WS)"
echo "No local robot, camera, or Lumos process was enabled."
