#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(dirname -- "$SCRIPT_DIR")
ENV_FILE=${RUNTIME_ENV_FILE:-$PROJECT_ROOT/config/runtime.env}
RUN_DIR=$PROJECT_ROOT/logs/run

if [[ ! -r "$ENV_FILE" ]]; then
  echo "ERROR: runtime environment file is missing: $ENV_FILE" >&2
  exit 1
fi

set -a
source "$ENV_FILE"
set +a

stop_one() {
  local name=$1
  local pid_file=$2
  if [[ ! -r "$pid_file" ]]; then
    echo "$name: not running (no PID file)"
    return
  fi

  local pid
  pid=$(<"$pid_file")
  if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
    echo "$name: stale PID file"
    rm -f -- "$pid_file"
    return
  fi

  local resolved_cwd
  resolved_cwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)
  case "$resolved_cwd" in
    "$PROJECT_ROOT"/*) ;;
    *)
      echo "ERROR: refusing to stop PID $pid; cwd is outside project: $resolved_cwd" >&2
      return 1
      ;;
  esac

  local pgid sid
  pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
  sid=$(ps -o sid= -p "$pid" | tr -d ' ')
  if [[ "$pgid" != "$pid" || "$sid" != "$pid" ]]; then
    echo "ERROR: refusing to stop PID $pid; it is not an isolated session leader" >&2
    return 1
  fi

  local member member_cwd member_stat
  while read -r member; do
    [[ -n "$member" ]] || continue
    member_cwd=$(readlink -f "/proc/$member/cwd" 2>/dev/null || true)
    member_stat=$(ps -o stat= -p "$member" | tr -d ' ')
    case "$member_cwd" in
      "$PROJECT_ROOT"/*) ;;
      "")
        if [[ "$member_stat" != Z* ]]; then
          echo "ERROR: refusing to stop session $sid; PID $member has no verifiable cwd" >&2
          return 1
        fi
        ;;
      *)
        echo "ERROR: refusing to stop session $sid; PID $member cwd is outside project: $member_cwd" >&2
        return 1
        ;;
    esac
  done < <(ps --sid "$sid" -o pid=)

  kill -TERM -- "-$pgid"
  for _ in {1..100}; do
    if ! ps --sid "$sid" -o pid= | grep -q .; then
      rm -f -- "$pid_file"
      echo "$name: stopped isolated session $sid"
      return
    fi
    sleep 0.1
  done
  echo "ERROR: $name session $sid did not stop after SIGTERM; no SIGKILL sent" >&2
  return 1
}

stop_one web-$WEB_PORT "$RUN_DIR/web-$WEB_PORT.pid"
stop_one voice-$VOICE_PORT "$RUN_DIR/voice-$VOICE_PORT.pid"
