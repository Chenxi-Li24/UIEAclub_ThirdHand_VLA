# ThirdHand Policy 服务环境变量（复制为 .env 或直接 export）
# 不提交真实 token / 密码 / 私钥。

# 监听地址与端口
THIRDHAND_POLICY_HOST=0.0.0.0
THIRDHAND_POLICY_PORT=8080

# ACT checkpoint 目录（启用 lerobot_act 时才需要；未配置时 lerobot_act 不可用）
THIRDHAND_POLICY_CHECKPOINT=

# frames/masks/states 存储目录（lerobot_act 按 frameId/maskRef/robotStateRef 引用解析）
THIRDHAND_POLICY_ARTIFACT_DIR=

# torch 设备（cpu / cuda）
THIRDHAND_POLICY_DEVICE=cpu

# 动作块单步时长（毫秒）
THIRDHAND_POLICY_DT_MS=100

# fake_act 测试步数
THIRDHAND_POLICY_FAKE_STEPS=3

# 是否启用 fake_act kind（联调测试用）
THIRDHAND_POLICY_ENABLE_FAKE=1

# startouch_action_chunk_adapter_v1 是否已注册（Robot 模块交付并注册后置 1；
# 未注册时 Policy 不会产出 act_chunk，按契约回退 fixed_baseline 或 fail-closed）
THIRDHAND_POLICY_ACT_CHUNK_ADAPTER_AVAILABLE=0
