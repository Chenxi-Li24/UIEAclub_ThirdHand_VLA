});

const activeViewTimeoutTimer = setInterval(() => activeView.checkTimeout(), 250);
activeViewTimeoutTimer.unref();
const graspTimeoutTimer = setInterval(() => graspController.checkTimeout(), 250);
graspTimeoutTimer.unref();

function shutdown() {
  console.log('\n[shutdown] closing...');
  cancelGroundingForAll('server_shutdown');
  lumosService.shutdown();
  clearInterval(activeViewTimeoutTimer);
  clearInterval(graspTimeoutTimer);
  if (activeView.session) activeView.cancel({ sessionId: activeView.session.sessionId });
  if (visualAlignController.active) visualAlignController.cancel('server_shutdown');
  if (graspController.active) graspController.cancel('server_shutdown');
  cameraBridge.shutdown();
  bridge.shutdown();
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(1), 1000).unref();
}

process.on('SIGINT', shutdown);
process.on('SIGTERM', shutdown);
