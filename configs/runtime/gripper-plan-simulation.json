{
  "profile": "gripper-plan-simulation",
  "description": "Browser acceptance for the authorized gripper chain. Robot is simulated; existing loopback Speech and Vision are read-only upstreams.",
  "services": [
    {
      "id": "robot",
      "command": "${NODE}",
      "args": ["${ROOT}/services/robot/src/server.js"],
      "cwd": "${ROOT}",
      "env": {
        "ROBOT_HOST": "127.0.0.1",
        "ROBOT_PORT": "13000",
        "ROBOT_EXECUTION_TOKEN_FILE": "${ROOT}/runtime/run/robot-execution.token",
        "STARTOUCH_SIMULATE": "1",
        "STARTOUCH_REQUIRE_CAN_RX": "0",
        "STARTOUCH_INIT_SETTLE_SEC": "0"
      },
      "bind": "127.0.0.1",
      "port": 13000,
      "shutdownOrder": 10,
      "enabled": true
    },
    {
      "id": "orchestrator",
      "command": "${NODE}",
      "args": ["${ROOT}/apps/orchestrator/src/server.js"],
      "cwd": "${ROOT}",
      "env": {
        "ORCHESTRATOR_HOST": "127.0.0.1",
        "ORCHESTRATOR_PORT": "13200",
        "ROBOT_HTTP_URL": "http://127.0.0.1:13000",
        "ROBOT_EXECUTION_WS_URL": "ws://127.0.0.1:13000/execution",
        "ROBOT_EXECUTION_TOKEN_FILE": "${ROOT}/runtime/run/robot-execution.token"
      },
      "bind": "127.0.0.1",
      "port": 13200,
      "shutdownOrder": 90,
      "enabled": true
    },
    {
      "id": "web",
      "command": "${NODE}",
      "args": ["${ROOT}/apps/web/src/server.js"],
      "cwd": "${ROOT}",
      "env": {
        "WEB_HOST": "192.168.58.68",
        "WEB_PORT": "19983",
        "ROBOT_WS_URL": "ws://127.0.0.1:13000/ws",
        "ORCHESTRATOR_WS_URL": "ws://127.0.0.1:13200/plan",
        "VOICE_WS_URL": "ws://127.0.0.1:3004/v1/voice",
        "VISION_HTTP_URL": "http://127.0.0.1:3100",
        "VISION_WS_URL": "ws://127.0.0.1:3100/ws"
      },
      "bind": "192.168.58.68",
      "allowLan": true,
      "port": 19983,
      "shutdownOrder": 100,
      "enabled": true
    }
  ]
}
