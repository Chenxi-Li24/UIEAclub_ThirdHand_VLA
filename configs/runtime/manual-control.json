{
  "profile": "manual-control",
  "description": "Migrated web and Startouch Robot Service for operator-supervised CAN control.",
  "services": [
    {
      "id": "robot",
      "command": "${NODE}",
      "args": ["${ROOT}/services/robot/src/server.js"],
      "cwd": "${ROOT}",
      "env": {
        "ROBOT_HOST": "127.0.0.1",
        "ROBOT_PORT": "3000",
        "STARTOUCH_SIMULATE": "0",
        "STARTOUCH_DRY_RUN": "0",
        "STARTOUCH_CAN_INTERFACE": "can0",
        "STARTOUCH_REQUIRE_CAN_RX": "1"
      },
      "bind": "127.0.0.1",
      "port": 3000,
      "shutdownOrder": 100,
      "enabled": true
    },
    {
      "id": "web",
      "command": "${NODE}",
      "args": ["${ROOT}/apps/web/src/server.js"],
      "cwd": "${ROOT}",
      "env": {
        "WEB_HOST": "192.168.58.68",
        "WEB_PORT": "9983",
        "ROBOT_WS_URL": "ws://127.0.0.1:3000/ws"
      },
      "bind": "192.168.58.68",
      "allowLan": true,
      "port": 9983,
      "shutdownOrder": 10,
      "enabled": true
    }
  ]
}
