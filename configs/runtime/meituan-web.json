{
  "profile": "meituan-web",
  "description": "Meituan 1034 source migration: read-only Robot state, Vision and Speech; motion execution is not enabled.",
  "services": [
    {
      "id": "meituan-web",
      "command": "${NODE}",
      "args": ["${ROOT}/apps/meituan/src/server.js"],
      "cwd": "${ROOT}",
      "env": {
        "WEB_HOST": "192.168.58.68",
        "WEB_PORT": "1034",
        "ROBOT_ASSETS_DIR": "${ROOT}/assets/robot",
        "ROBOT_WS_URL": "ws://127.0.0.1:3000/ws",
        "VOICE_WS_URL": "ws://127.0.0.1:3004/v1/voice",
        "LANGUAGE_REAL_CONTROL": "0",
        "DIRECTIONAL_CONTROL_ENABLED": "1",
        "DIRECTIONAL_REAL_CONTROL": "0",
        "VISION_HTTP_URL": "http://127.0.0.1:3100",
        "VISION_WS_URL": "ws://127.0.0.1:3100/ws",
        "VA_HTTP_URL": "http://127.0.0.1:8766"
      },
      "bind": "192.168.58.68",
      "allowLan": true,
      "port": 1034,
      "ensureProbe": {
        "type": "http-json",
        "path": "/health",
        "expect": { "serviceId": "web" }
      },
      "shutdownOrder": 100,
      "enabled": true
    }
  ]
}
