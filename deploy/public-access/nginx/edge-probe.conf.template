# C1b candidate ONLY. Replaces the backed-up active system edge vhost after review.
# Not the later command/telemetry/media ingress; no business forwarding.
server {
    listen 80;
    listen [::]:80;
    server_name edge.uiea-thirdhand.com;
    root /www/wwwroot/thirdhand-edge-acme;
    location ^~ /.well-known/acme-challenge/ { try_files $uri =404; }
    location / { return 404; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name edge.uiea-thirdhand.com;
    ssl_certificate /www/server/panel/vhost/cert/edge.uiea-thirdhand.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/edge.uiea-thirdhand.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_client_certificate /etc/thirdhand-probe/probe-ca.pem;
    ssl_verify_client on;
    ssl_verify_depth 1;
    client_max_body_size 16k;
    access_log off;
    error_log /var/log/nginx/thirdhand-edge.error.log warn;
    location ~ ^/edge/v1/(?:connect|healthz)$ {
        proxy_pass http://unix:/run/thirdhand-relay/edge.sock;
        proxy_http_version 1.1;
        proxy_set_header Host edge.uiea-thirdhand.com;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;
        # Preserve Cookie/Origin; relay rejects browser requests even with mTLS.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
        proxy_buffering off;
    }
    location / { return 404; }
}
