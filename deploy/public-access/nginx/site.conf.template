# Server-scope include after public HTTPS and business acceptance are complete.
# Candidate file: /etc/thirdhand/nginx/thirdhand-business.conf
# C1a verified the serving service is /usr/sbin/nginx with /etc/nginx/sites-enabled/.
# Include this only from the reviewed active main vhost; Baota's extension tree
# belongs to a different, inactive Nginx and is not the publication destination.
# Keep the existing root, ACME include, static assets and site content intact.
# Install business-upstream.inc separately at /etc/thirdhand/nginx/.
# This file is not enabled by creating it in Git.

location ~ ^/(?:control|history|login|register|forgot-password|reset-password|verify-email)(?:\.html)?$ {
    if ($scheme != https) { return 308 https://uiea-thirdhand.com$request_uri; }
    if ($host != uiea-thirdhand.com) { return 308 https://uiea-thirdhand.com$request_uri; }
    include /etc/thirdhand/nginx/business-upstream.inc;
}
location ^~ /control-assets/ {
    if ($scheme != https) { return 308 https://uiea-thirdhand.com$request_uri; }
    include /etc/thirdhand/nginx/business-upstream.inc;
}
location ^~ /api/v1/ {
    if ($scheme != https) { return 308 https://uiea-thirdhand.com$request_uri; }
    include /etc/thirdhand/nginx/business-upstream.inc;
}
location = /stream/v1/control {
    if ($scheme != https) { return 308 https://uiea-thirdhand.com$request_uri; }
    proxy_pass http://127.0.0.1:3200;
    proxy_http_version 1.1;
    proxy_set_header Host uiea-thirdhand.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
    proxy_buffering off;
}
# No legacy SDK, voice, camera or execution proxy is publicly forwarded.
location ~ ^/(?:ws|execution|voice|vision|meituan|camera|edge-control|edge-media)(?:/|$) { return 404; }
location ^~ /internal/ { return 404; }
# Media stays closed until B6's authenticated signalling/revocation path is tested.
location ^~ /media/ { return 404; }
