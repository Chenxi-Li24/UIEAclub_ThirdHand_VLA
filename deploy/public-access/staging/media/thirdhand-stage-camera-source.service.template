[Unit]
Description=ThirdHand staging camera private source adapter
After=network.target
[Service]
User=nieqingcao
Group=nieqingcao
Environment=PYTHONPATH=__IMMUTABLE_CAMERA_SOURCE__
ExecStart=__CAMERA_VENV__/bin/python -m thirdhand_edge.camera_source_gate --token-file __CAMERA_PRIVATE__/source-token --port 3112
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LimitCORE=0
MemoryMax=64M
[Install]
WantedBy=multi-user.target
