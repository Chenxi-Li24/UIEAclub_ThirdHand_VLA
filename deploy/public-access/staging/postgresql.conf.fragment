listen_addresses = ''
port = 55440
unix_socket_directories = '/run/thirdhand-stage-db'
unix_socket_permissions = 0770
unix_socket_group = 'thirdhand-stage-db'
max_connections = 20
shared_buffers = '48MB'
work_mem = '2MB'
maintenance_work_mem = '24MB'
max_wal_size = '128MB'
min_wal_size = '32MB'
wal_level = replica
archive_mode = on
archive_timeout = '5min'
archive_command = 'test ! -f /var/lib/thirdhand-stage-backups/wal/%f && cp %p /var/lib/thirdhand-stage-backups/wal/%f'
logging_collector = off
log_statement = 'none'
log_min_error_statement = 'panic'
