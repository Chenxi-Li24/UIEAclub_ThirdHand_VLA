# Optional overrides for scripts/start_ubuntu.sh.
# The defaults assume startouch_sdk is at ~/arm/startouch_sdk and the
# LumosTouch Conda environment is under ~/miniconda3.

# STARTOUCH_PYTHON="$HOME/miniconda3/envs/LumosTouch/bin/python"
# STARTOUCH_SDK_PATH="$HOME/arm/startouch_sdk"
# STARTOUCH_CAN_INTERFACE=can0
# STARTOUCH_GRIPPER=1
# STARTOUCH_SPEED_SCALE=0.05
# WEB_HOST=0.0.0.0
# WEB_PORT=3000

# Optional camera services. Model weights and calibration output remain local.
# CAMERA_ENABLED=1
# CAMERA_YOLO_MODEL="$PWD/yolov8n.pt"
# CAMERA_CALIB_FILE="$HOME/calibration/d435_handeye_result.json"
# CAMERA_DETECT_INTERVAL=10
# LUMOS_HTTP_PORT=3001

# XVisio dual-service forwarding. Port 3100 owns camera/perception; port 3000
# remains the only Startouch command boundary.
XVISION_PROXY_ENABLED=1
XVISION_SERVICE_URL=http://127.0.0.1:3100
XVISION_WS_URL=ws://127.0.0.1:3100/ws

# Keep locked until the physical hand-eye validation checkpoint has passed.
VISION_ROBOT_EXECUTION_ENABLED=0

# Diagnostic modes. Never enable both for normal hardware operation.
# STARTOUCH_SIMULATE=1
# STARTOUCH_DRY_RUN=1
