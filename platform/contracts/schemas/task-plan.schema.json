{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thirdhand.task-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "taskId", "planId", "revision", "targetRef", "risk", "steps", "risks"],
  "properties": {
    "schema": {"const": "thirdhand.task-plan.v1"},
    "taskId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "targetRef": {"type": "string", "minLength": 1},
    "risk": {"enum": ["read-only", "physical-motion"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skillId"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "skillId": {"type": "string", "minLength": 1},
          "operation": {"type": "string"},
          "parameters": {"type": "object"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"risk": {"const": "physical-motion"}}, "required": ["risk"]},
      "then": {"properties": {"risks": {"type": "array", "minItems": 1}}}
    }
  ]
}
