# Template only. Fill secrets in an OS-protected file outside Git.
NODE_ENV=production
PUBLIC_ORIGIN=https://uiea-thirdhand.com
CLOUD_BIND_HOST=127.0.0.1
CLOUD_PORT=3200
# Enable only behind the reviewed loopback Nginx configuration, which overwrites X-Real-IP.
TRUST_PROXY_LOOPBACK=0
# Separate least-privilege runtime and controlled migration credentials.
IDENTITY_DATABASE_URL=postgresql://thirdhand_runtime:REPLACE@127.0.0.1:5432/thirdhand
MIGRATION_DATABASE_URL=postgresql://thirdhand_migrator:REPLACE@127.0.0.1:5432/thirdhand
# Independent cryptographically random 32-byte base64 values. Empty values refuse startup.
CSRF_KEY_BASE64=
MFA_KEY_ID=v1
MFA_KEY_BASE64=
# Private directory shared only by the API and separate export worker. No webroot.
# Leaving it empty disables exports, while history queries remain available.
EXPORT_PRIVATE_DIRECTORY=
# Registration refuses to create an account until a mail transport is configured.
# Open Observer registration. Email verification and rate limits remain required.
REGISTRATION_MODE=open
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Used only with REGISTRATION_MODE=restricted (the legacy default if unset).
# Keep approved real recipient addresses only in the server's private configuration.
# In restricted mode, an explicitly empty value is rejected. Open mode ignores it.
SMTP_ALLOWED_RECIPIENTS_JSON=
