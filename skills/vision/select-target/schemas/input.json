{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {"enum": ["select", "release"]},
    "stableId": {"type": "integer", "minimum": 1, "maximum": 5},
    "maxAgeMs": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 500}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "select"}}},
      "then": {"required": ["stableId"]}
    }
  ]
}
